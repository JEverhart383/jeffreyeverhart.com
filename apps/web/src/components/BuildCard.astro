---
import { formatMonthYear } from '@/lib/collections';
interface Props {
  title: string;
  date: Date;
  slug: string;
  summary?: string;
  heroImage?: string;
  kind?: 'woodworking' | 'electronics' | 'mixed';
  status?: 'planned' | 'in-progress' | 'complete' | 'retired';
}

const { title, date, slug, summary, heroImage, kind = 'woodworking', status = 'complete' } = Astro.props;

const kindLabels: Record<string, string> = {
  woodworking: 'Woodworking',
  electronics: 'Electronics',
  mixed: 'Wood + electronics',
};

const statusLabels: Record<string, string> = {
  planned: 'Planned',
  'in-progress': 'In progress',
  complete: 'Complete',
  retired: 'Retired',
};

// Only the states that aren't a finished object are worth a badge.
const showStatus = status !== 'complete';

const formattedDate = formatMonthYear(date);
---

<article class="build-card bg-white rounded-lg shadow-sm border border-gray-100 overflow-hidden flex flex-col">
  <a href={`/work/builds/${slug}`} class="block relative aspect-[4/3] bg-gray-100">
    {heroImage ? (
      <img src={heroImage} alt="" class="w-full h-full object-cover" loading="lazy" />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-gray-300">
        <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.25">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437"/>
        </svg>
      </div>
    )}
    {showStatus && (
      <span class="absolute top-2 left-2 bg-brand-yellow text-gray-900 text-[11px] font-sans font-semibold px-2 py-0.5 rounded">
        {statusLabels[status]}
      </span>
    )}
  </a>

  <div class="p-4 flex flex-col flex-1">
    <p class="text-xs text-gray-500 font-sans mb-1">
      {formattedDate}
      <span> &middot; {kindLabels[kind] ?? kind}</span>
    </p>
    <h2 class="text-base font-sans font-bold text-gray-900 mb-2">
      <a href={`/work/builds/${slug}`} class="hover:text-brand-blue transition-colors">{title}</a>
    </h2>
    {summary && (
      <p class="font-serif text-gray-600 text-sm leading-relaxed line-clamp-3">{summary}</p>
    )}
  </div>
</article>
