---
import { navLinks, type NavLink } from '@/config/nav';

const currentPath = Astro.url.pathname;

/** A link is active on its own page and anywhere beneath it. */
function isActive(href: string | undefined): boolean {
  if (!href) return false;
  return currentPath === href || (href !== '/' && currentPath.startsWith(href));
}

/** A dropdown is active when any of its children is. */
function isGroupActive(link: NavLink): boolean {
  return (link.children ?? []).some((child) => isActive(child.href));
}
---

<header class="site-nav fixed top-0 left-0 right-0 z-50 bg-brand-blue border-b-4 border-brand-yellow">
  <div class="max-w-5xl mx-auto px-4 flex items-center h-14 gap-4">
    <a href="/" class="brand-logo font-brand text-white text-2xl leading-none mr-auto">JE</a>

    <nav class="hidden sm:flex items-center gap-6">
      {navLinks.map((link) => (
        link.children ? (
          <div class="nav-group relative">
            {/* A parent with an href stays clickable; one without is just a menu label. */}
            {link.href ? (
              <a
                href={link.href}
                class:list={[
                  'nav-group-trigger font-sans text-white hover:text-brand-yellow transition-colors text-sm font-medium flex items-center gap-1',
                  { 'underline': isActive(link.href) || isGroupActive(link) }
                ]}
              >
                {link.label}
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                </svg>
              </a>
            ) : (
              <button
                type="button"
                class:list={[
                  'nav-group-trigger font-sans text-white hover:text-brand-yellow transition-colors text-sm font-medium flex items-center gap-1',
                  { 'underline': isGroupActive(link) }
                ]}
              >
                {link.label}
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                </svg>
              </button>
            )}
            <div class="nav-dropdown absolute left-0 top-full pt-2 min-w-[12rem]">
              <div class="bg-brand-blue border border-blue-700 rounded-b shadow-lg py-1">
                {link.children.map((child) => (
                  <a
                    href={child.href}
                    class:list={[
                      'block px-4 py-2 font-sans text-white hover:text-brand-yellow hover:bg-blue-800 transition-colors text-sm',
                      { 'underline': isActive(child.href) }
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class:list={[
              'font-sans text-white hover:text-brand-yellow transition-colors text-sm font-medium',
              { 'underline': isActive(link.href) }
            ]}
          >
            {link.label}
          </a>
        )
      ))}
    </nav>

    <div class="social-icons flex items-center gap-3 text-white">
      <a href="https://twitter.com/j_everhart383" target="_blank" rel="noopener noreferrer" aria-label="Twitter" class="hover:text-brand-yellow transition-colors">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.741l7.73-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/></svg>
      </a>
      <a href="https://www.linkedin.com/in/jeff-everhart-42248b44" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="hover:text-brand-yellow transition-colors">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="https://github.com/JEverhart383" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="hover:text-brand-yellow transition-colors">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
      </a>
      <a href="https://www.youtube.com/user/JeffEverhart0721" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="hover:text-brand-yellow transition-colors">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
      </a>
    </div>

    <button id="mobile-menu-toggle" class="sm:hidden text-white" aria-label="Toggle navigation">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden sm:hidden bg-brand-blue px-4 pb-3 border-t border-blue-700">
    {navLinks.map((link) => (
      link.children ? (
        <div class="py-2">
          {link.href ? (
            <a href={link.href} class="block font-sans text-xs uppercase tracking-widest text-blue-200 hover:text-brand-yellow py-1">
              {link.label}
            </a>
          ) : (
            <p class="font-sans text-xs uppercase tracking-widest text-blue-200">{link.label}</p>
          )}
          {link.children.map((child) => (
            <a href={child.href} class="block text-white hover:text-brand-yellow py-2 pl-3 font-sans text-sm">
              {child.label}
            </a>
          ))}
        </div>
      ) : (
        <a href={link.href} class="block text-white hover:text-brand-yellow py-2 font-sans text-sm">
          {link.label}
        </a>
      )
    ))}
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
</script>

<style>
  :global(body) { padding-top: 3.5rem; }

  /* CSS-only dropdown. `focus-within` covers the trigger button itself, so
     tabbing to it reveals the menu and makes the links focusable. */
  .nav-dropdown {
    visibility: hidden;
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .nav-group:hover .nav-dropdown,
  .nav-group:focus-within .nav-dropdown {
    visibility: visible;
    opacity: 1;
  }
</style>
