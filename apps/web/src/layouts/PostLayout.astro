---
import { formatDate } from '@/lib/collections';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  date: Date;
  categories?: string[];
  description?: string;
}

const { title, date, categories = [], description } = Astro.props;

const formattedDate = formatDate(date);
---

<BaseLayout title={`${title} | Jeff Everhart`} description={description}>
  <!-- Post hero -->
  <div class="post-hero bg-brand-light-blue text-white py-16 px-4 text-center">
    <div class="max-w-2xl mx-auto">
      <h1 class="font-sans text-3xl sm:text-4xl font-bold">{title}</h1>
      <p class="mt-3 font-sans text-sm opacity-90">
        {formattedDate}
        {categories.length > 0 && <span> &middot; {categories.join(', ')}</span>}
      </p>
    </div>
  </div>

  <div class="post-content-area max-w-2xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none font-serif">
      <slot />
    </div>

    <nav class="mt-12 flex justify-between font-sans text-sm">
      <slot name="prev" />
      <slot name="next" />
    </nav>
  </div>
</BaseLayout>
