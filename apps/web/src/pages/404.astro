---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404 | Jeff Everhart">
  <div class="max-w-xl mx-auto px-4 py-32 text-center">
    <h1 class="font-sans text-6xl font-bold text-brand-blue mb-4">404</h1>
    <p class="font-serif text-gray-600 mb-8">Page not found. Maybe it moved?</p>
    <a href="/" class="bg-brand-yellow hover:bg-yellow-500 text-gray-900 font-sans font-semibold px-6 py-3 rounded transition-colors">
      Back Home
    </a>
  </div>
</BaseLayout>
