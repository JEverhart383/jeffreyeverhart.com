---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await page.render();
---

<BaseLayout title={`${page.data.title} | Jeff Everhart`} description={page.data.description}>
  <div class="bg-brand-light-blue text-white py-12 px-4 text-center">
    <h1 class="font-sans text-4xl font-bold">{page.data.title}</h1>
  </div>

  {page.data.heroImage && (
    <div class="max-w-3xl mx-auto px-4 pt-10">
      <img src={page.data.heroImage} alt="" class="w-full rounded-lg shadow-sm" />
    </div>
  )}

  <div class="max-w-2xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none font-serif">
      <Content />
    </div>
  </div>
</BaseLayout>
