---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BuildCard from '@/components/BuildCard.astro';
import { getCollection } from 'astro:content';
import { published, byDateDesc } from '@/lib/collections';

const builds = (await getCollection('builds', published)).sort(byDateDesc);
---

<BaseLayout
  title="Builds | Jeff Everhart"
  description="Things built in the physical world — woodworking, Raspberry Pi, and microcontroller projects."
>
  <div class="page-hero bg-brand-light-blue text-white py-12 px-4 text-center">
    <h1 class="font-sans text-4xl font-bold">Builds</h1>
  </div>

  <section class="max-w-5xl mx-auto px-4 py-12">
    <p class="font-serif text-gray-600 text-center max-w-2xl mx-auto mb-10">
      Things that exist off the screen: furniture and shop projects, and the
      Raspberry Pi and microcontroller builds that end up wired into them.
    </p>

    {builds.length === 0 ? (
      <p class="font-serif text-gray-500 text-center">No builds yet.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {builds.map((build) => (
          <BuildCard
            title={build.data.title}
            date={build.data.date}
            slug={build.slug}
            summary={build.data.summary}
            heroImage={build.data.heroImage ?? build.data.images[0]}
            kind={build.data.kind}
            status={build.data.status}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
