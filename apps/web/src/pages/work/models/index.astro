---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ModelCard from '@/components/ModelCard.astro';
import { getCollection } from 'astro:content';
import { published, byDateDesc } from '@/lib/collections';

const models = (await getCollection('models', published)).sort(byDateDesc);
---

<BaseLayout
  title="3D Models | Jeff Everhart"
  description="Parametric and sculpted 3D models, with renders, print settings, and source files."
>
  <div class="page-hero bg-brand-light-blue text-white py-12 px-4 text-center">
    <h1 class="font-sans text-4xl font-bold">3D Models</h1>
  </div>

  <section class="max-w-5xl mx-auto px-4 py-12">
    {models.length === 0 ? (
      <p class="font-serif text-gray-500 text-center">No models yet.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {models.map((model) => (
          <ModelCard
            title={model.data.title}
            date={model.data.date}
            slug={model.slug}
            summary={model.data.summary}
            heroImage={model.data.heroImage ?? model.data.images[0]}
            tools={model.data.tools}
            status={model.data.status}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
